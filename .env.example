# Copy this file to `.env` and adjust if needed.
#   cp .env.example .env

# HTTP port
PORT=3001

# SQLite database file (created automatically on first run)
DATABASE_URL=sqlite://myanbet365.db

# Football fixtures API (used by the "Auto Import Fixtures" button).
# `{date}` is replaced with YYYY-MM-DD. Teams are imported; odds are entered manually.
# Default (TheSportsDB free endpoint) is used if this is not set:
FIXTURES_API_URL=https://www.thesportsdb.com/api/v1/json/3/eventsday.php?d={date}&s=Soccer

# Optional API key sent as the `x-apisports-key` header (for API-Football).
# Example API-Football config:
#   FIXTURES_API_URL=https://v3.football.api-sports.io/fixtures?date={date}
#   FIXTURES_API_KEY=your_api_football_key
FIXTURES_API_KEY=

# REQUIRED for sync: only fixtures whose league name contains one of these
# (comma separated, case-insensitive substring) are imported.
# If left empty, the sync imports NOTHING (never all leagues by accident).
FIXTURES_LEAGUES=English Premier League,Spanish La Liga,German Bundesliga,Italian Serie A,French Ligue 1,English League Championship,UEFA Champions League,UEFA Europa League,Conference League,UEFA Nations League,World Cup,European Championship,Copa America,African Cup,Asian Cup,Gold Cup,Friendlies,Qualification

# Alternative: exact league IDs (best for API-Football). Takes priority over names.
# Common API-Football ids:
#   39=Premier League, 140=La Liga, 78=Bundesliga, 135=Serie A, 61=Ligue 1,
#   40=Championship, 2=UEFA Champions League, 3=Europa League, 848=Conference League,
#   1=World Cup, 4=Euro, 9=Copa America, 5=UEFA Nations League
FIXTURES_LEAGUE_IDS=
