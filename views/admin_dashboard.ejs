<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>ibet789 Style Admin Dashboard</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#f0f2f5] text-slate-800 font-sans min-h-screen flex flex-col md:flex-row antialiased text-sm">

  <!-- Mobile Header -->
  <header class="md:hidden bg-[#0f3460] text-white px-4 py-3 flex justify-between items-center sticky top-0 z-40 shadow">
    <span class="font-black text-amber-400 tracking-wider text-lg">MYANBET<span class="text-white">789</span></span>
    <button id="mobileMenuBtn" class="p-1.5 text-slate-200 hover:text-white">
      <i data-lucide="menu" class="w-6 h-6"></i>
    </button>
  </header>

  <!-- Mobile Sidebar Backdrop -->
  <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>

  <!-- Include External Sidebar Partial -->
  <%- include('partials/sidebar') %>

  <!-- Main Content Wrapper -->
  <main class="flex-1 flex flex-col min-w-0 bg-[#eef1f6]">

    <!-- Classic Top Banner / Subheader -->
    <div class="bg-white border-b border-slate-300 px-5 py-3 flex flex-wrap items-center justify-between gap-3 shadow-sm text-sm">
      <div class="flex items-center space-x-4">
        <span class="font-bold text-slate-800 uppercase tracking-wide">ibet789 Management Center</span>
        <span class="text-slate-300">|</span>
        <span class="text-slate-600">Total Members: <strong class="text-blue-700 font-bold"><%= members.length %></strong></span>
        <span class="text-slate-300">|</span>
        <span class="text-slate-600">Total Pool: <strong class="text-emerald-600 font-bold"><%= Number(totalPool).toLocaleString() %> MMK</strong></span>
      </div>
      <div class="flex items-center space-x-2">
        <span class="inline-block w-2.5 h-2.5 rounded-full bg-emerald-500"></span>
        <span class="font-bold text-emerald-700">Online</span>
      </div>
    </div>

    <div class="p-4 sm:p-5 space-y-5">

      <!-- 1. Member Management Section -->
      <section id="tab-member-mgmt" class="tab-content space-y-4">
        <!-- Add Member Bar -->
        <div class="bg-white p-4 rounded-lg border border-slate-300 shadow-sm">
          <div class="text-sm font-bold text-slate-800 uppercase mb-3 flex items-center space-x-2">
            <i data-lucide="user-plus" class="w-4 h-4 text-blue-700"></i>
            <span>Create New Member Account</span>
          </div>
          <form action="/admin/create-member" method="POST" class="grid grid-cols-1 sm:grid-cols-4 gap-3">
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Username</label>
              <input type="text" name="username" placeholder="Username" required class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-300 rounded focus:bg-white focus:outline-none focus:border-blue-600">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Password</label>
              <input type="password" name="password" placeholder="Password" required class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-300 rounded focus:bg-white focus:outline-none focus:border-blue-600">
            </div>
            <div>
              <label class="block text-xs font-semibold text-slate-600 mb-1">Initial Balance (MMK)</label>
              <input type="number" name="initialBalance" placeholder="0" min="0" class="w-full px-3 py-2 text-sm bg-slate-50 border border-slate-300 rounded focus:bg-white focus:outline-none focus:border-blue-600">
            </div>
            <div class="flex items-end">
              <button type="submit" class="w-full bg-[#0f3460] hover:bg-[#16213e] text-amber-300 font-bold py-2 rounded text-sm transition">
                + Save Member
              </button>
            </div>
          </form>
        </div>

        <!-- Member List Table -->
        <div class="bg-white rounded-lg border border-slate-300 shadow-sm overflow-hidden">
          <div class="bg-[#1f4068] text-white px-4 py-2.5 text-sm font-bold flex justify-between items-center">
            <span>Member List</span>
            <span class="text-xs font-normal text-slate-200">Total Count: <%= members.length %></span>
          </div>
          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm border-collapse">
              <thead class="bg-[#eaedf2] text-slate-700 border-b border-slate-300 text-xs uppercase font-bold">
                <tr>
                  <th class="p-3 border-r border-slate-300">ID</th>
                  <th class="p-3 border-r border-slate-300">Username</th>
                  <th class="p-3 border-r border-slate-300 text-right">Balance</th>
                  <th class="p-3 border-r border-slate-300">Created Date</th>
                  <th class="p-3 text-center">Actions</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                <% if (members.length === 0) { %>
                  <tr><td colspan="5" class="p-5 text-center text-slate-500 text-sm">No member accounts found</td></tr>
                <% } else { %>
                  <% members.forEach(m => { %>
                    <tr class="hover:bg-amber-50/60 transition">
                      <td class="p-3 border-r border-slate-200 font-mono text-slate-600">#<%= m.id %></td>
                      <td class="p-3 border-r border-slate-200 font-bold text-blue-900 text-base"><%= m.username %></td>
                      <td class="p-3 border-r border-slate-200 text-right font-mono font-bold text-emerald-700 text-base"><%= Number(m.balance).toLocaleString() %> MMK</td>
                      <td class="p-3 border-r border-slate-200 text-slate-500 text-xs"><%= new Date(m.created_at).toLocaleString() %></td>
                      <td class="p-3 text-center space-x-2">
                        <button class="px-3 py-1 bg-emerald-600 hover:bg-emerald-700 text-white font-bold rounded text-xs">Deposit</button>
                        <button class="px-3 py-1 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded text-xs">Withdraw</button>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      </section>

      

      <!-- 3. Match List Section -->
      <section id="tab-match-list" class="tab-content hidden">
        <div class="bg-white rounded-lg border border-slate-300 shadow-sm overflow-hidden">
          <div class="bg-[#1f4068] text-white px-4 py-2.5 text-sm font-bold">Active Match Schedule</div>
          <table class="w-full text-left text-sm border-collapse">
            <thead class="bg-[#eaedf2] text-slate-700 border-b border-slate-300 text-xs uppercase font-bold">
              <tr>
                <th class="p-3 border-r border-slate-300">Time</th>
                <th class="p-3 border-r border-slate-300">Match</th>
                <th class="p-3 border-r border-slate-300 text-center">Odds (1 / X / 2)</th>
                <th class="p-3 border-r border-slate-300 text-center">Status</th>
                <th class="p-3 text-center">Action</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <tr>
                <td class="p-3 border-r border-slate-200 text-slate-500 font-mono">20:00</td>
                <td class="p-3 border-r border-slate-200 font-bold text-blue-900 text-base">Arsenal vs Chelsea</td>
                <td class="p-3 border-r border-slate-200 text-center font-mono font-bold text-slate-700">1.85 / 3.40 / 4.10</td>
                <td class="p-3 border-r border-slate-200 text-center"><span class="bg-emerald-100 text-emerald-800 px-2 py-0.5 rounded text-xs font-bold">Open</span></td>
                <td class="p-3 text-center"><button class="text-blue-600 font-bold hover:underline">Edit</button></td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 4. Result Section -->
      <section id="tab-result" class="tab-content hidden">
        <div class="bg-white rounded-lg border border-slate-300 shadow-sm overflow-hidden">
          <div class="bg-[#1f4068] text-white px-4 py-2.5 text-sm font-bold">Match Result Settlement</div>
          <table class="w-full text-left text-sm border-collapse">
            <thead class="bg-[#eaedf2] text-slate-700 border-b border-slate-300 text-xs uppercase font-bold">
              <tr>
                <th class="p-3 border-r border-slate-300">Match</th>
                <th class="p-3 border-r border-slate-300">Total Bets</th>
                <th class="p-3 text-center">Settle Winner</th>
              </tr>
            </thead>
            <tbody>
              <tr>
                <td class="p-3 border-r border-slate-200 font-bold text-blue-900 text-base">Arsenal vs Chelsea</td>
                <td class="p-3 border-r border-slate-200 font-mono text-emerald-700 font-bold text-base">25 Bets (450,000 MMK)</td>
                <td class="p-3 text-center space-x-2">
                  <button class="px-3 py-1.5 bg-blue-700 hover:bg-blue-800 text-white font-bold rounded text-xs">Arsenal</button>
                  <button class="px-3 py-1.5 bg-slate-600 hover:bg-slate-700 text-white font-bold rounded text-xs">Draw</button>
                  <button class="px-3 py-1.5 bg-blue-700 hover:bg-blue-800 text-white font-bold rounded text-xs">Chelsea</button>
                </td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>

      <!-- 5. Report Section -->
      <section id="tab-report" class="tab-content hidden space-y-4">
        <div class="grid grid-cols-1 sm:grid-cols-3 gap-4">
          <div class="bg-white p-4 rounded-lg border border-slate-300 shadow-sm">
            <div class="text-slate-500 font-bold uppercase text-xs">Total Turnover</div>
            <div class="text-2xl font-black text-blue-900 mt-1">1,250,000 MMK</div>
          </div>
          <div class="bg-white p-4 rounded-lg border border-slate-300 shadow-sm">
            <div class="text-slate-500 font-bold uppercase text-xs">Total Payout</div>
            <div class="text-2xl font-black text-rose-700 mt-1">980,000 MMK</div>
          </div>
          <div class="bg-white p-4 rounded-lg border border-slate-300 shadow-sm">
            <div class="text-slate-500 font-bold uppercase text-xs">Net Company Profit</div>
            <div class="text-2xl font-black text-emerald-700 mt-1">+270,000 MMK</div>
          </div>
        </div>
      </section>

      <!-- 6. Break Section -->
      <section id="tab-break" class="tab-content hidden">
        <div class="bg-white p-4 rounded-lg border border-slate-300 shadow-sm space-y-4">
          <div class="font-bold text-slate-800 uppercase text-sm">Betting Limiter & Break Settings</div>
          <div class="flex items-center justify-between p-3.5 bg-slate-50 border border-slate-200 rounded">
            <div>
              <div class="font-bold text-slate-800 text-sm">Global Bet Lock</div>
              <div class="text-slate-500 text-xs mt-0.5">ပွဲစဉ်အားလုံး၏ လောင်းကြေးလက်ခံမှု ရပ်ဆိုင်းမည်</div>
            </div>
            <button class="px-4 py-2 bg-rose-600 hover:bg-rose-700 text-white font-bold rounded text-xs">Emergency Stop</button>
          </div>
        </div>
      </section>

    </div>
  </main>

  <script>
    lucide.createIcons();

    function switchTab(tabId) {
      document.querySelectorAll('.tab-content').forEach(el => el.classList.add('hidden'));
      const target = document.getElementById('tab-' + tabId);
      if (target) target.classList.remove('hidden');

      document.querySelectorAll('.nav-btn').forEach(btn => {
        if (btn.dataset.tab === tabId) {
          btn.classList.add('border-amber-400', 'bg-[#1f4068]', 'text-white');
          btn.classList.remove('border-transparent', 'text-slate-300');
        } else {
          btn.classList.remove('border-amber-400', 'bg-[#1f4068]', 'text-white');
          btn.classList.add('border-transparent', 'text-slate-300');
        }
      });
      closeMobileSidebar();
    }

    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const closeSidebarBtn = document.getElementById('closeSidebarBtn');
    const sidebar = document.getElementById('sidebar');
    const sidebarOverlay = document.getElementById('sidebarOverlay');

    function openMobileSidebar() {
      sidebar.classList.remove('-translate-x-full');
      sidebarOverlay.classList.remove('hidden');
    }

    function closeMobileSidebar() {
      sidebar.classList.add('-translate-x-full');
      sidebarOverlay.classList.add('hidden');
    }

    mobileMenuBtn?.addEventListener('click', openMobileSidebar);
    closeSidebarBtn?.addEventListener('click', closeMobileSidebar);
    sidebarOverlay?.addEventListener('click', closeMobileSidebar);
  </script>
</body>
</html>