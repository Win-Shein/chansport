<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Reports - MYANBET365</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#f0f2f5] text-slate-800 font-sans min-h-screen flex flex-col md:flex-row antialiased text-sm">

  <!-- Mobile Header -->
  <header class="md:hidden bg-[#0f3460] text-white px-4 py-3 flex justify-between items-center sticky top-0 z-40 shadow">
    <span class="font-black text-amber-400 tracking-wider text-lg">MYANBET<span class="text-white">365</span></span>
    <button id="mobileMenuBtn" class="p-1.5 text-slate-200 hover:text-white">
      <i data-lucide="menu" class="w-6 h-6"></i>
    </button>
  </header>

  <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>

  <!-- Include Sidebar -->
  <%- include('partials/sidebar') %>

  <!-- Main Content Wrapper -->
  <main class="flex-1 flex flex-col min-w-0 bg-[#eef1f6]">
    
    <!-- Top Subheader -->
    <div class="bg-white border-b border-slate-300 px-5 py-3 flex flex-wrap items-center justify-between gap-3 shadow-sm text-sm">
      <div class="flex items-center space-x-3">
        <span class="font-bold text-slate-800 uppercase tracking-wide">Financial & Betting Reports</span>
        <span class="text-slate-300">|</span>
        <span class="text-slate-600">
          <% if (subTab === 'credit') { %>
            Total Members: <strong class="text-blue-700 font-bold"><%= creditMembers.length %></strong>
          <% } else if (subTab === 'outstanding') { %>
            Active Slips: <strong class="text-blue-700 font-bold"><%= outstandingBets.length %></strong>
          <% } else { %>
            Reported Users: <strong class="text-blue-700 font-bold"><%= winLoseList.length %></strong>
          <% } %>
        </span>
      </div>

      <div class="flex items-center space-x-2">
        <button onclick="window.location.reload()" class="px-3 py-1.5 bg-slate-100 hover:bg-slate-200 text-slate-700 font-bold rounded text-xs transition flex items-center space-x-1 border border-slate-300">
          <i data-lucide="rotate-cw" class="w-3.5 h-3.5"></i>
          <span>Refresh</span>
        </button>
      </div>
    </div>

    <div class="p-4 sm:p-5 space-y-4">
      
      <!-- Sub-Tab Navigation Bar -->
      <div class="bg-white p-2 rounded-lg border border-slate-300 shadow-sm flex flex-wrap gap-2">
        <a href="/admin/report?tab=credit" class="px-4 py-2 rounded text-xs font-bold transition flex items-center space-x-1.5 <%= subTab === 'credit' ? 'bg-[#0f3460] text-amber-300 shadow' : 'bg-slate-100 hover:bg-slate-200 text-slate-700' %>">
          <i data-lucide="wallet" class="w-3.5 h-3.5"></i>
          <span>Credit Log</span>
        </a>
        <a href="/admin/report?tab=outstanding" class="px-4 py-2 rounded text-xs font-bold transition flex items-center space-x-1.5 <%= subTab === 'outstanding' ? 'bg-[#0f3460] text-amber-300 shadow' : 'bg-slate-100 hover:bg-slate-200 text-slate-700' %>">
          <i data-lucide="clock" class="w-3.5 h-3.5"></i>
          <span>Outstanding (<%= outstandingBets.length %>)</span>
        </a>
        <a href="/admin/report?tab=winlose" class="px-4 py-2 rounded text-xs font-bold transition flex items-center space-x-1.5 <%= subTab === 'winlose' ? 'bg-[#0f3460] text-amber-300 shadow' : 'bg-slate-100 hover:bg-slate-200 text-slate-700' %>">
          <i data-lucide="trending-up" class="w-3.5 h-3.5"></i>
          <span>Win / Lose Statement</span>
        </a>
      </div>

      <!-- ================= 1. CREDIT LOG (Deposit / Withdraw History) ================= -->
      <% if (subTab === 'credit') { %>
        <!-- Date Search Filter Bar -->
        <div class="bg-white p-3.5 rounded-lg border border-slate-300 shadow-sm flex flex-wrap items-center justify-between gap-3">
          <form action="/admin/report" method="GET" class="flex items-center space-x-2">
            <input type="hidden" name="tab" value="credit">
            <label class="text-xs font-bold text-slate-700 flex items-center space-x-1">
              <i data-lucide="calendar" class="w-4 h-4 text-blue-700"></i>
              <span><%= showAll ? 'Filter by Date:' : 'Showing (business day):' %></span>
            </label>
            <input
              type="date"
              name="filter_date"
              value="<%= filter_date %>"
              class="px-2.5 py-1.5 border border-slate-300 rounded text-xs bg-slate-50 focus:bg-white focus:outline-none focus:border-blue-600 font-semibold"
            >
            <button type="submit" class="px-3 py-1.5 bg-[#0f3460] hover:bg-[#16213e] text-amber-300 font-bold rounded text-xs transition shadow-sm">
              Search
            </button>
            <% if (!showAll) { %>
              <a href="/admin/report?tab=credit&filter_date=all" class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded text-xs transition">
                Show All
              </a>
            <% } else { %>
              <a href="/admin/report?tab=credit" class="px-3 py-1.5 bg-amber-100 hover:bg-amber-200 text-amber-800 font-bold rounded text-xs transition">
                Today
              </a>
            <% } %>
          </form>
        </div>

        <div class="bg-white rounded-lg border border-slate-300 shadow-sm overflow-hidden">
          <div class="bg-[#1f4068] text-white px-4 py-2.5 text-sm font-bold flex justify-between items-center">
            <span>Member Credit Log <%= filter_date ? `(${filter_date})` : '' %></span>
            <span class="text-xs font-normal text-slate-200">Total Accounts: <%= creditMembers.length %> &middot; Total Transactions: <%= creditLogs.length %></span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm border-collapse">
              <thead class="bg-[#eaedf2] text-slate-700 border-b border-slate-300 text-xs uppercase font-bold">
                <tr>
                  <th class="p-3 border-r border-slate-300 text-center w-12">No.</th>
                  <th class="p-3 border-r border-slate-300">Username</th>
                  <th class="p-3 border-r border-slate-300 text-right">Commission (%)</th>
                  <th class="p-3 border-r border-slate-300 text-right">Credit Balance</th>
                  <th class="p-3 border-r border-slate-300 text-right bg-emerald-50 text-emerald-900">Deposited</th>
                  <th class="p-3 border-r border-slate-300 text-right bg-amber-50 text-amber-900">Withdrawn</th>
                  <th class="p-3 border-r border-slate-300 text-center w-28">Status</th>
                  <th class="p-3 text-center w-24">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                <% if (creditMembers.length === 0) { %>
                  <tr>
                    <td colspan="8" class="p-6 text-center text-slate-500 font-medium">No members found.</td>
                  </tr>
                <% } else { %>
                  <% creditMembers.forEach((m, idx) => { %>
                    <tr class="hover:bg-amber-50/60 transition">
                      <td class="p-3 border-r border-slate-200 text-center font-mono font-bold text-slate-500 text-xs"><%= idx + 1 %></td>
                      <td class="p-3 border-r border-slate-200 font-bold text-slate-800">
                        <button type="button" onclick="showCreditLog(<%= m.id %>, '<%= m.username %>')" class="text-blue-700 hover:text-blue-900 hover:underline text-left">
                          <%= m.username %>
                        </button>
                      </td>
                      <td class="p-3 border-r border-slate-200 text-right font-mono font-bold text-blue-800"><%= m.commission %>%</td>
                      <td class="p-3 border-r border-slate-200 text-right font-mono font-black text-emerald-700 text-base"><%= Number(m.balance).toLocaleString() %> MMK</td>
                      <td class="p-3 border-r border-slate-200 text-right font-mono font-bold text-emerald-700 bg-emerald-50/40"><%= Number(m.total_deposit).toLocaleString() %></td>
                      <td class="p-3 border-r border-slate-200 text-right font-mono font-bold text-amber-800 bg-amber-50/40"><%= Number(m.total_withdraw).toLocaleString() %></td>
                      <td class="p-3 text-center">
                        <span class="px-2.5 py-0.5 rounded text-xs font-bold <%= m.status === 'ACTIVE' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                          <%= m.status %>
                        </span>
                      </td>
                      <td class="p-3 text-center">
                        <button type="button" onclick="showCreditLog(<%= m.id %>, '<%= m.username %>')" class="px-2 py-1 bg-[#0f3460] hover:bg-[#16213e] text-amber-300 rounded text-xs font-bold transition">
                          Details
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <!-- ================= 2. OUTSTANDING RUNNING BETS (BY MEMBER) ================= -->
      <% if (subTab === 'outstanding') { %>
        <div class="bg-white rounded-lg border border-slate-300 shadow-sm overflow-hidden">
          <div class="bg-[#1f4068] text-white px-4 py-2.5 text-sm font-bold flex justify-between items-center">
            <span>Outstanding Running Bets by Member</span>
            <span class="text-xs font-normal text-slate-200">Pending Slips: <%= outstandingBets.length %></span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm border-collapse">
              <thead class="bg-[#eaedf2] text-slate-700 border-b border-slate-300 text-xs uppercase font-bold">
                <tr>
                  <th class="p-3 border-r border-slate-300 text-center w-12">No.</th>
                  <th class="p-3 border-r border-slate-300">Member</th>
                  <th class="p-3 border-r border-slate-300 text-center w-32">Pending Slips</th>
                  <th class="p-3 border-r border-slate-300 text-right">Total Stake</th>
                  <th class="p-3 text-center w-24">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                <% if (outstandingByMember.length === 0) { %>
                  <tr>
                    <td colspan="5" class="p-6 text-center text-slate-500 font-medium">No outstanding running bets found.</td>
                  </tr>
                <% } else { %>
                  <% outstandingByMember.forEach((m, idx) => { %>
                    <tr class="hover:bg-amber-50/60 transition">
                      <td class="p-3 border-r border-slate-200 text-center font-mono font-bold text-slate-500 text-xs"><%= idx + 1 %></td>
                      <td class="p-3 border-r border-slate-200 font-bold text-slate-800">
                        <button type="button" onclick="showOutstandingBets(<%= m.user_id %>, '<%= m.username %>')" class="text-blue-700 hover:text-blue-900 hover:underline text-left">
                          <%= m.username %>
                        </button>
                      </td>
                      <td class="p-3 border-r border-slate-200 text-center font-mono font-bold text-slate-600"><%= m.total_bets %></td>
                      <td class="p-3 border-r border-slate-200 text-right font-mono font-bold text-slate-800 text-base"><%= Number(m.total_stake).toLocaleString() %> MMK</td>
                      <td class="p-3 text-center">
                        <button type="button" onclick="showOutstandingBets(<%= m.user_id %>, '<%= m.username %>')" class="px-2 py-1 bg-[#0f3460] hover:bg-[#16213e] text-amber-300 rounded text-xs font-bold transition">
                          Details
                        </button>
                      </td>
                    </tr>
                  <% }) %>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

      <!-- ================= 3. WIN / LOSE STATEMENT (WITH DETAIL MODAL TRIGGER) ================= -->
      <% if (subTab === 'winlose') { %>
        <!-- Date Search Filter Bar -->
        <div class="bg-white p-3.5 rounded-lg border border-slate-300 shadow-sm flex flex-wrap items-center justify-between gap-3">
          <form action="/admin/report" method="GET" class="flex items-center space-x-2">
            <input type="hidden" name="tab" value="winlose">
            <label class="text-xs font-bold text-slate-700 flex items-center space-x-1">
              <i data-lucide="calendar" class="w-4 h-4 text-blue-700"></i>
              <span><%= showAll ? 'Filter by Date:' : 'Showing (business day):' %></span>
            </label>
            <input
              type="date"
              name="filter_date"
              value="<%= filter_date %>"
              class="px-2.5 py-1.5 border border-slate-300 rounded text-xs bg-slate-50 focus:bg-white focus:outline-none focus:border-blue-600 font-semibold"
            >
            <button type="submit" class="px-3 py-1.5 bg-[#0f3460] hover:bg-[#16213e] text-amber-300 font-bold rounded text-xs transition shadow-sm">
              Search
            </button>
            <% if (!showAll) { %>
              <a href="/admin/report?tab=winlose&filter_date=all" class="px-3 py-1.5 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded text-xs transition">
                Show All
              </a>
            <% } else { %>
              <a href="/admin/report?tab=winlose" class="px-3 py-1.5 bg-amber-100 hover:bg-amber-200 text-amber-800 font-bold rounded text-xs transition">
                Today
              </a>
            <% } %>
          </form>
        </div>

        <!-- Win / Lose Table Container -->
        <div class="bg-white rounded-lg border border-slate-300 shadow-sm overflow-hidden">
          <div class="bg-[#1f4068] text-white px-4 py-2.5 text-sm font-bold flex justify-between items-center">
            <span>Member Win / Lose Statement <%= filter_date ? `(${filter_date})` : '' %></span>
            <span class="text-xs font-normal text-slate-200">Total Members: <%= winLoseList.length %></span>
          </div>

          <div class="overflow-x-auto">
            <table class="w-full text-left text-sm border-collapse">
              <thead class="bg-[#eaedf2] text-slate-700 border-b border-slate-300 text-xs uppercase font-bold">
                <tr>
                  <th class="p-3 border-r border-slate-300 text-center w-12">No.</th>
                  <th class="p-3 border-r border-slate-300">Member</th>
                  <th class="p-3 border-r border-slate-300 text-center w-16">Bets</th>
                  <th class="p-3 border-r border-slate-300 text-right">Stake (Turnover)</th>
                  <th class="p-3 border-r border-slate-300 text-right bg-amber-50 text-amber-950">Valid Amount</th>
                  <th class="p-3 border-r border-slate-300 text-right">Win / Lose (Net)</th>
                  <th class="p-3 border-r border-slate-300 text-right">Comm (%)</th>
                  <th class="p-3 border-r border-slate-300 text-right">Comm Amount</th>
                  <th class="p-3 text-right">Member Win / Lose</th>
                  <th class="p-3 text-center w-24">Action</th>
                </tr>
              </thead>
              <tbody class="divide-y divide-slate-200">
                <% if (winLoseList.length === 0) { %>
                  <tr>
                    <td colspan="10" class="p-6 text-center text-slate-500 font-medium">No member records found <%= filter_date ? 'for this date' : '' %>.</td>
                  </tr>
                <% } else { %>
                  <% 
                    let grandTurnover = 0;
                    let grandValid = 0;
                    let grandPayout = 0;
                    let grandComm = 0;
                    let grandMemberNet = 0;
                  %>
                  <% winLoseList.forEach((r, idx) => { %>
                    <%
                      const netWinLose = Number(r.payout || 0) - Number(r.turnover || 0);
                      grandTurnover += Number(r.turnover || 0);
                      grandValid += Number(r.valid_amount || 0);
                      grandPayout += netWinLose;
                      grandComm += Number(r.comm_amount || 0);
                      grandMemberNet += Number(r.member_net || 0);
                    %>
                    <tr class="hover:bg-amber-50/60 transition font-mono">
                      <td class="p-3 border-r border-slate-200 text-center font-bold text-slate-500 text-xs"><%= idx + 1 %></td>
                      <td class="p-3 border-r border-slate-200 font-sans font-bold text-slate-800">
                        <button type="button" onclick="showMemberBets(<%= r.user_id %>, '<%= r.username %>')" class="text-blue-700 hover:text-blue-900 hover:underline text-left">
                          <%= r.username %>
                        </button>
                      </td>
                      <td class="p-3 border-r border-slate-200 text-center font-bold text-slate-600"><%= r.total_bets %></td>
                      <td class="p-3 border-r border-slate-200 text-right font-bold text-slate-800"><%= Number(r.turnover).toLocaleString() %></td>
                      <td class="p-3 border-r border-slate-200 text-right font-black text-amber-900 bg-amber-50/50"><%= Number(r.valid_amount).toLocaleString() %></td>
                      <td class="p-3 border-r border-slate-200 text-right font-bold <%= netWinLose >= 0 ? 'text-emerald-700' : 'text-rose-600' %>">
                        <%= netWinLose >= 0 ? '+' : '' %><%= Number(netWinLose).toLocaleString() %>
                      </td>
                      <td class="p-3 border-r border-slate-200 text-right font-bold text-slate-600"><%= Number(r.comm_rate) %>%</td>
                      <td class="p-3 border-r border-slate-200 text-right font-bold text-purple-800"><%= Number(r.comm_amount).toLocaleString() %></td>
                      <td class="p-3 border-r border-slate-200 text-right font-black text-base <%= r.member_net >= 0 ? 'text-emerald-700' : 'text-rose-600' %>">
                        <%= r.member_net >= 0 ? '+' : '' %><%= Number(r.member_net).toLocaleString() %>
                      </td>
                      <td class="p-3 text-center">
                        <button type="button" onclick="showMemberBets(<%= r.user_id %>, '<%= r.username %>')" class="px-2 py-1 bg-[#0f3460] hover:bg-[#16213e] text-amber-300 rounded text-xs font-bold font-sans transition">
                          Details
                        </button>
                      </td>
                    </tr>
                  <% }) %>

                  <!-- Grand Total Row -->
                  <tr class="bg-slate-200 font-mono font-black border-t-2 border-slate-300">
                    <td colspan="3" class="p-3 text-center font-sans uppercase text-slate-800 border-r border-slate-300">Total</td>
                    <td class="p-3 text-right border-r border-slate-300 text-slate-900"><%= Number(grandTurnover).toLocaleString() %></td>
                    <td class="p-3 text-right border-r border-slate-300 text-amber-950 bg-amber-100"><%= Number(grandValid).toLocaleString() %></td>
                    <td class="p-3 text-right border-r border-slate-300 <%= grandPayout >= 0 ? 'text-emerald-800' : 'text-rose-700' %>">
                      <%= grandPayout >= 0 ? '+' : '' %><%= Number(grandPayout).toLocaleString() %>
                    </td>
                    <td class="p-3 text-right border-r border-slate-300 text-slate-600">-</td>
                    <td class="p-3 text-right border-r border-slate-300 text-purple-950"><%= Number(grandComm).toLocaleString() %></td>
                    <td class="p-3 text-right border-r border-slate-300 text-base <%= grandMemberNet >= 0 ? 'text-emerald-800' : 'text-rose-700' %>">
                      <%= grandMemberNet >= 0 ? '+' : '' %><%= Number(grandMemberNet).toLocaleString() %> MMK
                    </td>
                    <td class="p-3 text-center">-</td>
                  </tr>
                <% } %>
              </tbody>
            </table>
          </div>
        </div>
      <% } %>

    </div>
  </main>

  <!-- ================= MEMBER BET DETAILS MODAL ================= -->
  <div id="memberBetsModal" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-xl shadow-2xl max-w-4xl w-full border border-slate-300 overflow-hidden flex flex-col max-h-[85vh]">
      
      <!-- Modal Header -->
      <div class="bg-[#1f4068] text-white px-5 py-3 flex justify-between items-center font-bold text-sm">
        <span class="flex items-center space-x-2">
          <i data-lucide="list-ordered" class="w-4 h-4 text-amber-400"></i>
          <span>Member Betting Details: <span id="modalMemberName" class="text-amber-300"></span></span>
        </span>
        <button onclick="closeMemberBetsModal()" class="text-slate-300 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Modal Content (Table of Slips) -->
      <div class="p-4 overflow-y-auto flex-1">
        <table class="w-full text-left text-sm border-collapse">
          <thead class="bg-[#eaedf2] text-slate-700 border-b border-slate-300 text-xs uppercase font-bold sticky top-0">
            <tr>
              <th class="p-2.5 border-r border-slate-300 text-center w-12">No.</th>
              <th class="p-2.5 border-r border-slate-300">Match Teams</th>
              <th class="p-2.5 border-r border-slate-300 text-center">Score</th>
              <th class="p-2.5 border-r border-slate-300 text-center">Selection</th>
              <th class="p-2.5 border-r border-slate-300 text-center">Odd</th>
              <th class="p-2.5 border-r border-slate-300 text-right">Stake</th>
              <th class="p-2.5 border-r border-slate-300 text-right">Win / Lose</th>
              <th class="p-2.5 text-center">Result</th>
            </tr>
          </thead>
          <tbody id="memberBetsListBody" class="divide-y divide-slate-200 font-mono">
            <!-- Dynamically Populated by JavaScript -->
          </tbody>
        </table>
      </div>

      <!-- Modal Footer -->
      <div class="bg-slate-100 px-5 py-3 border-t border-slate-300 flex justify-between items-center text-xs">
        <span id="modalBetsCount" class="font-bold text-slate-600"></span>
        <button type="button" onclick="closeMemberBetsModal()" class="px-4 py-1.5 bg-[#0f3460] text-amber-300 font-bold rounded transition">
          Close
        </button>
      </div>

    </div>
  </div>

  <!-- ================= OUTSTANDING BET DETAILS MODAL ================= -->
  <div id="outstandingBetsModal" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-xl shadow-2xl max-w-4xl w-full border border-slate-300 overflow-hidden flex flex-col max-h-[85vh]">

      <!-- Modal Header -->
      <div class="bg-[#1f4068] text-white px-5 py-3 flex justify-between items-center font-bold text-sm">
        <span class="flex items-center space-x-2">
          <i data-lucide="list-ordered" class="w-4 h-4 text-amber-400"></i>
          <span>Outstanding Bets: <span id="outstandingModalMemberName" class="text-amber-300"></span></span>
        </span>
        <button onclick="closeOutstandingBetsModal()" class="text-slate-300 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Modal Content (Table of Slips) -->
      <div class="p-4 overflow-y-auto flex-1">
        <table class="w-full text-left text-sm border-collapse">
          <thead class="bg-[#eaedf2] text-slate-700 border-b border-slate-300 text-xs uppercase font-bold sticky top-0">
            <tr>
              <th class="p-2.5 border-r border-slate-300 text-center w-12">No.</th>
              <th class="p-2.5 border-r border-slate-300">Match Teams</th>
              <th class="p-2.5 border-r border-slate-300 text-center">Selection</th>
              <th class="p-2.5 border-r border-slate-300 text-center">Odd</th>
              <th class="p-2.5 border-r border-slate-300 text-right">Stake</th>
              <th class="p-2.5 text-center">Status</th>
            </tr>
          </thead>
          <tbody id="outstandingBetsListBody" class="divide-y divide-slate-200 font-mono">
            <!-- Dynamically Populated by JavaScript -->
          </tbody>
        </table>
      </div>

      <!-- Modal Footer -->
      <div class="bg-slate-100 px-5 py-3 border-t border-slate-300 flex justify-between items-center text-xs">
        <span id="outstandingModalBetsCount" class="font-bold text-slate-600"></span>
        <button type="button" onclick="closeOutstandingBetsModal()" class="px-4 py-1.5 bg-[#0f3460] text-amber-300 font-bold rounded transition">
          Close
        </button>
      </div>

    </div>
  </div>

  <!-- ================= CREDIT LOG DETAILS MODAL ================= -->
  <div id="creditLogModal" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-xl shadow-2xl max-w-3xl w-full border border-slate-300 overflow-hidden flex flex-col max-h-[85vh]">

      <!-- Modal Header -->
      <div class="bg-[#1f4068] text-white px-5 py-3 flex justify-between items-center font-bold text-sm">
        <span class="flex items-center space-x-2">
          <i data-lucide="wallet" class="w-4 h-4 text-amber-400"></i>
          <span>Credit Log: <span id="creditLogModalMemberName" class="text-amber-300"></span></span>
        </span>
        <button onclick="closeCreditLogModal()" class="text-slate-300 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <!-- Modal Content (Timestamped Transaction List) -->
      <div class="p-4 overflow-y-auto flex-1">
        <table class="w-full text-left text-sm border-collapse">
          <thead class="bg-[#eaedf2] text-slate-700 border-b border-slate-300 text-xs uppercase font-bold sticky top-0">
            <tr>
              <th class="p-2.5 border-r border-slate-300 text-center w-12">No.</th>
              <th class="p-2.5 border-r border-slate-300">Date &amp; Time</th>
              <th class="p-2.5 border-r border-slate-300 text-center">Type</th>
              <th class="p-2.5 border-r border-slate-300 text-right">Amount</th>
              <th class="p-2.5 border-r border-slate-300 text-right">Balance After</th>
              <th class="p-2.5 border-r border-slate-300">Note</th>
              <th class="p-2.5 text-center">By</th>
            </tr>
          </thead>
          <tbody id="creditLogListBody" class="divide-y divide-slate-200 font-mono">
            <!-- Dynamically Populated by JavaScript -->
          </tbody>
        </table>
      </div>

      <!-- Modal Footer -->
      <div class="bg-slate-100 px-5 py-3 border-t border-slate-300 flex justify-between items-center text-xs">
        <span id="creditLogModalCount" class="font-bold text-slate-600"></span>
        <button type="button" onclick="closeCreditLogModal()" class="px-4 py-1.5 bg-[#0f3460] text-amber-300 font-bold rounded transition">
          Close
        </button>
      </div>

    </div>
  </div>

  <script>
    lucide.createIcons();

    // Store All Settled Bets passed from Backend
    const allSettledBets = <%- JSON.stringify(typeof allSettledBets !== 'undefined' ? allSettledBets : []) %>;

    // Store All Outstanding (PENDING) Bets passed from Backend
    const allOutstandingBets = <%- JSON.stringify(typeof outstandingBets !== 'undefined' ? outstandingBets : []) %>;

    function showOutstandingBets(userId, username) {
      document.getElementById('outstandingModalMemberName').textContent = username;
      const tbody = document.getElementById('outstandingBetsListBody');
      tbody.innerHTML = '';

      const userBets = allOutstandingBets.filter(b => b.user_id === userId);
      document.getElementById('outstandingModalBetsCount').textContent = `Total Slips: ${userBets.length}`;

      if (userBets.length === 0) {
        tbody.innerHTML = `<tr><td colspan="6" class="p-6 text-center text-slate-400 font-sans font-medium">No outstanding bets found for this member.</td></tr>`;
      } else {
        userBets.forEach((b, index) => {
          const row = document.createElement('tr');
          row.className = 'hover:bg-amber-50/60 transition';
          row.innerHTML = `
            <td class="p-2.5 border-r border-slate-200 text-center font-bold text-slate-500 text-xs">${index + 1}</td>
            <td class="p-2.5 border-r border-slate-200 font-sans font-bold text-blue-950">${b.home_team} vs ${b.away_team}</td>
            <td class="p-2.5 border-r border-slate-200 text-center font-bold text-purple-900">${b.choice}</td>
            <td class="p-2.5 border-r border-slate-200 text-center font-bold text-emerald-700">${b.odd}</td>
            <td class="p-2.5 border-r border-slate-200 text-right font-bold text-slate-800">${Number(b.amount).toLocaleString()}</td>
            <td class="p-2.5 text-center">
              <span class="bg-amber-100 text-amber-800 px-2 py-0.5 rounded text-[11px] font-bold animate-pulse">RUNNING</span>
            </td>
          `;
          tbody.appendChild(row);
        });
      }

      document.getElementById('outstandingBetsModal').classList.remove('hidden');
    }

    function closeOutstandingBetsModal() {
      document.getElementById('outstandingBetsModal').classList.add('hidden');
    }

    // Store All Credit Log (Deposit/Withdraw) entries passed from Backend
    const allCreditLogs = <%- JSON.stringify(typeof creditLogs !== 'undefined' ? creditLogs : []) %>;

    function showCreditLog(userId, username) {
      document.getElementById('creditLogModalMemberName').textContent = username;
      const tbody = document.getElementById('creditLogListBody');
      tbody.innerHTML = '';

      const userLogs = allCreditLogs.filter(l => l.user_id === userId);
      document.getElementById('creditLogModalCount').textContent = `Total Transactions: ${userLogs.length}`;

      if (userLogs.length === 0) {
        tbody.innerHTML = `<tr><td colspan="7" class="p-6 text-center text-slate-400 font-sans font-medium">No deposit/withdraw history found for this member.</td></tr>`;
      } else {
        userLogs.forEach((l, index) => {
          const isDeposit = l.type === 'DEPOSIT';
          const badgeClass = isDeposit ? 'bg-emerald-100 text-emerald-800' : 'bg-amber-100 text-amber-800';
          const amountClass = isDeposit ? 'text-emerald-700' : 'text-amber-800';
          const amountSign = isDeposit ? '+' : '-';
          const dateStr = new Date(l.created_at).toLocaleString();

          const row = document.createElement('tr');
          row.className = 'hover:bg-amber-50/60 transition';
          row.innerHTML = `
            <td class="p-2.5 border-r border-slate-200 text-center font-bold text-slate-500 text-xs">${index + 1}</td>
            <td class="p-2.5 border-r border-slate-200 font-sans font-bold text-slate-700 text-xs">${dateStr}</td>
            <td class="p-2.5 border-r border-slate-200 text-center">
              <span class="px-2 py-0.5 rounded text-[11px] font-bold ${badgeClass}">${l.type}</span>
            </td>
            <td class="p-2.5 border-r border-slate-200 text-right font-black ${amountClass}">${amountSign}${Number(l.amount).toLocaleString()}</td>
            <td class="p-2.5 border-r border-slate-200 text-right font-bold text-slate-800">${Number(l.balance_after).toLocaleString()}</td>
            <td class="p-2.5 border-r border-slate-200 font-sans text-slate-500 text-xs">${l.note || '-'}</td>
            <td class="p-2.5 text-center font-sans font-bold text-slate-600 text-xs">${l.admin_username || '-'}</td>
          `;
          tbody.appendChild(row);
        });
      }

      document.getElementById('creditLogModal').classList.remove('hidden');
    }

    function closeCreditLogModal() {
      document.getElementById('creditLogModal').classList.add('hidden');
    }

    function showMemberBets(userId, username) {
      document.getElementById('modalMemberName').textContent = username;
      const tbody = document.getElementById('memberBetsListBody');
      tbody.innerHTML = '';

      const userBets = allSettledBets.filter(b => b.user_id === userId);
      document.getElementById('modalBetsCount').textContent = `Total Slips: ${userBets.length}`;

      if (userBets.length === 0) {
        tbody.innerHTML = `<tr><td colspan="8" class="p-6 text-center text-slate-400 font-sans font-medium">No betting history found for this member.</td></tr>`;
      } else {
        userBets.forEach((b, index) => {
          let badgeColor = 'bg-slate-200 text-slate-800';
          if (b.status === 'WON') badgeColor = 'bg-emerald-100 text-emerald-800';
          else if (b.status === 'LOST') badgeColor = 'bg-rose-100 text-rose-800';

          const netWinLose = Number(b.payout || 0) - Number(b.amount || 0);
          const netClass = netWinLose >= 0 ? 'text-emerald-700' : 'text-rose-600';
          const netSign = netWinLose >= 0 ? '+' : '';

          const row = document.createElement('tr');
          row.className = 'hover:bg-amber-50/60 transition';
          row.innerHTML = `
            <td class="p-2.5 border-r border-slate-200 text-center font-bold text-slate-500 text-xs">${index + 1}</td>
            <td class="p-2.5 border-r border-slate-200 font-sans font-bold text-blue-950">${b.home_team} vs ${b.away_team}</td>
            <td class="p-2.5 border-r border-slate-200 text-center font-bold text-slate-700">${b.home_score ?? '-'} : ${b.away_score ?? '-'}</td>
            <td class="p-2.5 border-r border-slate-200 text-center font-bold text-purple-900">${b.choice}</td>
            <td class="p-2.5 border-r border-slate-200 text-center font-bold text-emerald-700">${b.odd}</td>
            <td class="p-2.5 border-r border-slate-200 text-right font-bold text-slate-800">${Number(b.amount).toLocaleString()}</td>
            <td class="p-2.5 border-r border-slate-200 text-right font-black ${netClass}">${netSign}${netWinLose.toLocaleString()}</td>
            <td class="p-2.5 text-center">
              <span class="px-2 py-0.5 rounded text-[11px] font-bold ${badgeColor}">${b.status}</span>
            </td>
          `;
          tbody.appendChild(row);
        });
      }

      document.getElementById('memberBetsModal').classList.remove('hidden');
    }

    function closeMemberBetsModal() {
      document.getElementById('memberBetsModal').classList.add('hidden');
    }

    // Mobile Sidebar Drawer
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const closeSidebarBtn = document.getElementById('closeSidebarBtn');
    const sidebar = document.getElementById('sidebar');
    const sidebarOverlay = document.getElementById('sidebarOverlay');

    mobileMenuBtn?.addEventListener('click', () => { sidebar?.classList.remove('-translate-x-full'); sidebarOverlay?.classList.remove('hidden'); });
    closeSidebarBtn?.addEventListener('click', () => { sidebar?.classList.add('-translate-x-full'); sidebarOverlay?.classList.add('hidden'); });
    sidebarOverlay?.addEventListener('click', () => { sidebar?.classList.add('-translate-x-full'); sidebarOverlay?.classList.add('hidden'); });
  </script>
</body>
</html>