<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Members Management - MYANBET365</title>
  <script src="https://cdn.tailwindcss.com"></script>
  <script src="https://unpkg.com/lucide@latest"></script>
</head>
<body class="bg-[#f0f2f5] text-slate-800 font-sans min-h-screen flex flex-col md:flex-row antialiased text-sm">

  <!-- Mobile Header -->
  <header class="md:hidden bg-[#0f3460] text-white px-4 py-3 flex justify-between items-center sticky top-0 z-40 shadow">
    <span class="font-black text-amber-400 tracking-wider text-lg">MYANBET<span class="text-white">365</span></span>
    <button id="mobileMenuBtn" class="p-1.5 text-slate-200 hover:text-white">
      <i data-lucide="menu" class="w-6 h-6"></i>
    </button>
  </header>

  <div id="sidebarOverlay" class="fixed inset-0 bg-black/50 z-40 hidden md:hidden"></div>

  <!-- Include Sidebar -->
  <%- include('partials/sidebar') %>

  <!-- Main Content Area -->
  <main class="flex-1 flex flex-col min-w-0 bg-[#eef1f6]">
    
    <!-- Top Subheader -->
    <div class="bg-white border-b border-slate-300 px-5 py-3 flex flex-wrap items-center justify-between gap-3 shadow-sm text-sm">
      <div class="flex items-center space-x-3">
        <span class="font-bold text-slate-800 uppercase tracking-wide">Member Management</span>
        <span class="text-slate-300">|</span>
        <span class="text-slate-600">Total Members: <strong class="text-blue-700 font-bold"><%= members.length %></strong></span>
        <span class="text-slate-300">|</span>
        <span class="text-slate-600">Total Pool: <strong class="text-emerald-700 font-mono font-bold"><%= Number(totalPool).toLocaleString() %> MMK</strong></span>
      </div>
      <button onclick="openCreateModal()" class="px-4 py-2 bg-[#0f3460] hover:bg-[#16213e] text-amber-300 font-bold rounded text-xs transition flex items-center space-x-1.5 shadow">
        <i data-lucide="user-plus" class="w-4 h-4"></i>
        <span>Create Member</span>
      </button>
    </div>

    <div class="p-4 sm:p-5 space-y-4">
      
      <!-- Members Table Container -->
      <div class="bg-white rounded-lg border border-slate-300 shadow-sm overflow-hidden">
        <div class="bg-[#1f4068] text-white px-4 py-2.5 text-sm font-bold flex justify-between items-center">
          <span>All Registered Members</span>
          <span class="text-xs font-normal text-slate-200">Manage limits, balances & credentials</span>
        </div>

        <div class="overflow-x-auto">
          <table class="w-full text-left text-sm border-collapse">
            <thead class="bg-[#eaedf2] text-slate-700 border-b border-slate-300 text-xs uppercase font-bold">
              <tr>
                <th class="p-3 border-r border-slate-300 text-center w-12">No.</th>
                <th class="p-3 border-r border-slate-300">Username</th>
                <th class="p-3 border-r border-slate-300 text-right">Balance</th>
                <th class="p-3 border-r border-slate-300 text-right bg-amber-50 text-amber-950">Bet Limit</th>
                <th class="p-3 border-r border-slate-300 text-right">Commission</th>
                <th class="p-3 border-r border-slate-300 text-center w-28">Status</th>
                <th class="p-3 text-center">Actions</th>
              </tr>
            </thead>
            <tbody class="divide-y divide-slate-200">
              <% if (members.length === 0) { %>
                <tr>
                  <td colspan="7" class="p-6 text-center text-slate-500 font-medium">No members found. Click "Create Member" to add one.</td>
                </tr>
              <% } else { %>
                <% members.forEach((m, index) => { %>
                  <tr class="hover:bg-amber-50/60 transition">
                    <td class="p-3 border-r border-slate-200 text-center font-mono font-bold text-slate-500 text-xs"><%= index + 1 %></td>
                    <td class="p-3 border-r border-slate-200 font-bold text-slate-800"><%= m.username %></td>
                    <td class="p-3 border-r border-slate-200 text-right font-mono font-bold text-emerald-700 text-base"><%= Number(m.balance).toLocaleString() %> MMK</td>
                    <td class="p-3 border-r border-slate-200 text-right font-mono font-black text-amber-900 bg-amber-50/40 text-base"><%= Number(m.bet_limit || 100000).toLocaleString() %> MMK</td>
                    <td class="p-3 border-r border-slate-200 text-right font-mono font-bold text-blue-800"><%= m.commission %>%</td>
                    <td class="p-3 border-r border-slate-200 text-center">
                      <span class="px-2.5 py-0.5 rounded text-xs font-bold <%= m.status === 'ACTIVE' ? 'bg-emerald-100 text-emerald-800' : 'bg-rose-100 text-rose-800' %>">
                        <%= m.status %>
                      </span>
                    </td>
                    <td class="p-3 text-center whitespace-nowrap">
                      <div class="flex items-center justify-center space-x-2">
                        <!-- Edit Button -->
                        <button 
                          type="button" 
                          onclick='openEditModal(<%= JSON.stringify(m) %>)'
                          class="px-2.5 py-1 bg-blue-600 hover:bg-blue-700 text-white rounded text-xs font-bold flex items-center space-x-1 transition shadow-sm"
                        >
                          <i data-lucide="edit-3" class="w-3.5 h-3.5"></i>
                          <span>Edit</span>
                        </button>

                        <!-- Toggle Status Button -->
                        <form action="/admin/toggle-status-member/<%= m.id %>" method="POST" class="inline">
                          <button 
                            type="submit" 
                            class="px-2.5 py-1 <%= m.status === 'ACTIVE' ? 'bg-amber-600 hover:bg-amber-700' : 'bg-emerald-600 hover:bg-emerald-700' %> text-white rounded text-xs font-bold transition shadow-sm"
                          >
                            <%= m.status === 'ACTIVE' ? 'Suspend' : 'Activate' %>
                          </button>
                        </form>

                        <!-- Delete Button -->
                        <form action="/admin/delete-member/<%= m.id %>" method="POST" onsubmit="return confirm('Are you sure you want to delete this member? All bet histories will be removed.');" class="inline">
                          <button 
                            type="submit" 
                            class="px-2.5 py-1 bg-rose-600 hover:bg-rose-700 text-white rounded text-xs font-bold flex items-center space-x-1 transition shadow-sm"
                          >
                            <i data-lucide="trash-2" class="w-3.5 h-3.5"></i>
                            <span>Del</span>
                          </button>
                        </form>
                      </div>
                    </td>
                  </tr>
                <% }) %>
              <% } %>
            </tbody>
          </table>
        </div>
      </div>

    </div>
  </main>

  <!-- ================= CREATE MEMBER MODAL ================= -->
  <div id="createModal" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full border border-slate-300 overflow-hidden">
      <div class="bg-[#1f4068] text-white px-5 py-3 flex justify-between items-center font-bold text-sm">
        <span class="flex items-center space-x-2">
          <i data-lucide="user-plus" class="w-4 h-4 text-amber-400"></i>
          <span>Create New Member</span>
        </span>
        <button onclick="closeCreateModal()" class="text-slate-300 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form id="createMemberForm" onsubmit="return handleCreateMember(event)" class="p-5 space-y-3.5 text-sm">
        <div id="createMemberAlert" class="hidden bg-rose-50 border border-rose-300 text-rose-700 text-xs font-semibold rounded px-3 py-2"></div>
        <div>
          <label class="block font-bold text-slate-700 mb-1 text-xs">Username</label>
          <input type="text" name="username" required placeholder="e.g. member01" class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 focus:bg-white focus:outline-none focus:border-blue-600">
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1 text-xs">Password</label>
          <input type="password" name="password" required placeholder="Enter password" class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 focus:bg-white focus:outline-none focus:border-blue-600">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1 text-xs">Opening Balance (MMK)</label>
            <input type="number" name="initialBalance" min="0" step="1000" value="0" class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 font-mono font-bold text-emerald-700">
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1 text-xs">Commission (%)</label>
            <input type="number" name="commission" min="0" max="100" step="0.5" value="5" class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 font-mono font-bold text-blue-800">
          </div>
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1 text-xs">Max Bet Limit (MMK)</label>
          <input type="number" name="bet_limit" min="1000" step="1000" value="100000" required placeholder="e.g. 100000" class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 font-mono font-black text-amber-900 focus:bg-white focus:border-blue-600">
        </div>

        <div class="flex items-center justify-end space-x-2 pt-3 border-t border-slate-200">
          <button type="button" onclick="closeCreateModal()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded text-xs transition">Cancel</button>
          <button type="submit" id="btnCreateMember" class="px-5 py-2 bg-[#0f3460] hover:bg-[#16213e] text-amber-300 font-bold rounded text-xs transition shadow">Save Member</button>
        </div>
      </form>
    </div>
  </div>

  <!-- ================= EDIT MEMBER MODAL ================= -->
  <div id="editModal" class="fixed inset-0 bg-black/60 z-50 flex items-center justify-center p-4 hidden">
    <div class="bg-white rounded-xl shadow-2xl max-w-md w-full border border-slate-300 overflow-hidden">
      <div class="bg-[#1f4068] text-white px-5 py-3 flex justify-between items-center font-bold text-sm">
        <span class="flex items-center space-x-2">
          <i data-lucide="edit-3" class="w-4 h-4 text-amber-400"></i>
          <span>Edit Member Details</span>
        </span>
        <button onclick="closeEditModal()" class="text-slate-300 hover:text-white">
          <i data-lucide="x" class="w-5 h-5"></i>
        </button>
      </div>

      <form id="editMemberForm" method="POST" class="p-5 space-y-3.5 text-sm">
        <div>
          <label class="block font-bold text-slate-700 mb-1 text-xs">Username</label>
          <input type="text" id="edit_username" name="username" required class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 focus:bg-white">
        </div>
        <div>
          <label class="block font-bold text-slate-700 mb-1 text-xs">New Password (Leave blank to keep current)</label>
          <input type="password" name="new_password" placeholder="Enter new password" class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 focus:bg-white">
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1 text-xs">Balance (MMK)</label>
            <input type="number" id="edit_balance" name="balance" min="0" step="500" required class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 font-mono font-bold text-emerald-700">
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1 text-xs">Commission (%)</label>
            <input type="number" id="edit_commission" name="commission" min="0" max="100" step="0.5" required class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 font-mono font-bold text-blue-800">
          </div>
        </div>
        <div class="grid grid-cols-2 gap-3">
          <div>
            <label class="block font-bold text-slate-700 mb-1 text-xs">Max Bet Limit (MMK)</label>
            <input type="number" id="edit_bet_limit" name="bet_limit" min="1000" step="1000" required class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 font-mono font-black text-amber-900">
          </div>
          <div>
            <label class="block font-bold text-slate-700 mb-1 text-xs">Account Status</label>
            <select id="edit_status" name="status" required class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-white font-bold text-slate-800">
              <option value="ACTIVE">ACTIVE</option>
              <option value="SUSPENDED">SUSPENDED</option>
            </select>
          </div>
        </div>

        <div class="flex items-center justify-end space-x-2 pt-3 border-t border-slate-200">
          <button type="button" onclick="closeEditModal()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded text-xs transition">Cancel</button>
          <button type="submit" class="px-5 py-2 bg-[#0f3460] hover:bg-[#16213e] text-amber-300 font-bold rounded text-xs transition shadow">Update Member</button>
        </div>
      </form>
    </div>
  </div>

  <script>
    lucide.createIcons();

    function openCreateModal() {
      document.getElementById('createMemberForm').reset();
      hideCreateMemberAlert();
      document.getElementById('createModal').classList.remove('hidden');
    }

    function closeCreateModal() {
      document.getElementById('createModal').classList.add('hidden');
    }

    function showCreateMemberAlert(msg) {
      const box = document.getElementById('createMemberAlert');
      box.textContent = msg;
      box.classList.remove('hidden');
    }

    function hideCreateMemberAlert() {
      document.getElementById('createMemberAlert').classList.add('hidden');
    }

    // Ajax Form Submission (stay on the same modal/page on validation error)
    async function handleCreateMember(event) {
      event.preventDefault();
      hideCreateMemberAlert();

      const form = event.target;
      const btn = document.getElementById('btnCreateMember');
      const originalLabel = btn.textContent;
      btn.disabled = true;
      btn.textContent = 'Saving...';

      const payload = {
        username: form.username.value,
        password: form.password.value,
        initialBalance: form.initialBalance.value,
        commission: form.commission.value,
        bet_limit: form.bet_limit.value
      };

      try {
        const response = await fetch('/admin/create-member', {
          method: 'POST',
          headers: { 'Content-Type': 'application/json' },
          body: JSON.stringify(payload)
        });
        const data = await response.json();

        if (response.ok && data.success) {
          window.location.reload();
        } else {
          showCreateMemberAlert(data.message || 'Failed to create member.');
          btn.disabled = false;
          btn.textContent = originalLabel;
        }
      } catch (err) {
        showCreateMemberAlert('Network error. Please try again.');
        btn.disabled = false;
        btn.textContent = originalLabel;
      }

      return false;
    }

    function openEditModal(m) {
      document.getElementById('editMemberForm').action = '/admin/edit-member/' + m.id;
      document.getElementById('edit_username').value = m.username;
      document.getElementById('edit_balance').value = m.balance;
      document.getElementById('edit_commission').value = m.commission;
      document.getElementById('edit_bet_limit').value = m.bet_limit || 100000;
      document.getElementById('edit_status').value = m.status;

      document.getElementById('editModal').classList.remove('hidden');
    }

    function closeEditModal() {
      document.getElementById('editModal').classList.add('hidden');
    }

    // Mobile Sidebar Drawer
    const mobileMenuBtn = document.getElementById('mobileMenuBtn');
    const closeSidebarBtn = document.getElementById('closeSidebarBtn');
    const sidebar = document.getElementById('sidebar');
    const sidebarOverlay = document.getElementById('sidebarOverlay');

    mobileMenuBtn?.addEventListener('click', () => { sidebar?.classList.remove('-translate-x-full'); sidebarOverlay?.classList.remove('hidden'); });
    closeSidebarBtn?.addEventListener('click', () => { sidebar?.classList.add('-translate-x-full'); sidebarOverlay?.classList.add('hidden'); });
    sidebarOverlay?.addEventListener('click', () => { sidebar?.classList.add('-translate-x-full'); sidebarOverlay?.classList.add('hidden'); });
  </script>
</body>
</html>