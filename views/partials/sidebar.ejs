<!-- Sidebar Component -->
<aside id="sidebar" class="fixed md:sticky top-0 left-0 h-screen w-64 bg-[#16213e] text-slate-200 border-r border-[#0f3460] flex flex-col justify-between z-50 transform -translate-x-full md:translate-x-0 transition-transform duration-150 ease-in-out select-none">
  <div>
    <!-- Logo Header -->
    <div class="h-14 bg-[#0f3460] px-4 flex items-center justify-between border-b border-[#1f4068]">
      <div class="flex items-center space-x-2">
        <span class="font-extrabold text-lg tracking-wider text-amber-400">MYANBET<span class="text-white">365</span></span>
        <span class="bg-rose-600 text-xs font-bold text-white px-2 py-0.5 rounded">ADMIN</span>
      </div>
      <button id="closeSidebarBtn" class="md:hidden text-slate-300 hover:text-white">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <!-- Navigation Links -->
    <nav class="py-3 text-sm font-semibold space-y-1">
      <a href="/admin/members" class="w-full flex items-center space-x-3 px-4 py-2.5 text-left border-l-4 <%= (page === 'members') ? 'border-amber-400 bg-[#1f4068] text-white' : 'border-transparent text-slate-300 hover:bg-[#1f4068]/60 hover:text-white' %> transition">
        <i data-lucide="users" class="w-5 h-5"></i>
        <span>Member Management</span>
      </a>

      <a href="/admin/add-match" class="w-full flex items-center space-x-3 px-4 py-2.5 text-left border-l-4 <%= (page === 'add_match') ? 'border-amber-400 bg-[#1f4068] text-white' : 'border-transparent text-slate-300 hover:bg-[#1f4068]/60 hover:text-white' %> transition">
        <i data-lucide="plus-circle" class="w-5 h-5"></i>
        <span>Add Match</span>
      </a>

      <a href="/admin/match-list" class="w-full flex items-center space-x-3 px-4 py-2.5 text-left border-l-4 <%= (page === 'match_list') ? 'border-amber-400 bg-[#1f4068] text-white' : 'border-transparent text-slate-300 hover:bg-[#1f4068]/60 hover:text-white' %> transition">
        <i data-lucide="list" class="w-5 h-5"></i>
        <span>Match List</span>
      </a>

      <a href="/admin/result" class="w-full flex items-center space-x-3 px-4 py-2.5 text-left border-l-4 <%= (page === 'result') ? 'border-amber-400 bg-[#1f4068] text-white' : 'border-transparent text-slate-300 hover:bg-[#1f4068]/60 hover:text-white' %> transition">
        <i data-lucide="check-square" class="w-5 h-5"></i>
        <span>Result</span>
      </a>

      <a href="/admin/report" class="w-full flex items-center space-x-3 px-4 py-2.5 text-left border-l-4 <%= (page === 'report') ? 'border-amber-400 bg-[#1f4068] text-white' : 'border-transparent text-slate-300 hover:bg-[#1f4068]/60 hover:text-white' %> transition">
        <i data-lucide="bar-chart-2" class="w-5 h-5"></i>
        <span>Report</span>
      </a>

      <a href="/admin/break" class="w-full flex items-center space-x-3 px-4 py-2.5 text-left border-l-4 <%= (page === 'break') ? 'border-amber-400 bg-[#1f4068] text-white' : 'border-transparent text-slate-300 hover:bg-[#1f4068]/60 hover:text-white' %> transition">
        <i data-lucide="shield-alert" class="w-5 h-5"></i>
        <span>Break</span>
      </a>

      <button type="button" onclick="openChangePasswordModal()" class="w-full flex items-center space-x-3 px-4 py-2.5 text-left border-l-4 border-transparent text-slate-300 hover:bg-[#1f4068]/60 hover:text-white transition">
        <i data-lucide="key" class="w-5 h-5"></i>
        <span>Password</span>
      </button>
    </nav>
  </div>

  <!-- Admin Profile Footer -->
  <div class="h-14 bg-[#0f3460] px-4 flex items-center justify-between border-t border-[#1f4068] text-sm">
    <div class="truncate">
      <span class="text-slate-400 text-xs block">Logged in as</span>
      <strong class="text-amber-300 font-bold text-sm"><%= admin.username %></strong>
    </div>
    <a href="/logout" class="text-rose-400 hover:text-rose-300 flex items-center space-x-1.5 font-bold" title="Logout">
      <i data-lucide="log-out" class="w-4 h-4"></i>
      <span>Exit</span>
    </a>
  </div>
</aside>

<!-- ================= CHANGE PASSWORD MODAL ================= -->
<div id="changePasswordModal" class="fixed inset-0 bg-black/60 z-[60] flex items-center justify-center p-4 hidden">
  <div class="bg-white rounded-xl shadow-2xl max-w-sm w-full border border-slate-300 overflow-hidden text-slate-800 text-sm">
    <div class="bg-[#1f4068] text-white px-5 py-3 flex justify-between items-center font-bold text-sm">
      <span class="flex items-center space-x-2">
        <i data-lucide="key" class="w-4 h-4 text-amber-400"></i>
        <span>Change Password</span>
      </span>
      <button type="button" onclick="closeChangePasswordModal()" class="text-slate-300 hover:text-white">
        <i data-lucide="x" class="w-5 h-5"></i>
      </button>
    </div>

    <form id="changePasswordForm" onsubmit="return handleChangePasswordSubmit(event)" class="p-5 space-y-3.5">
      <div id="changePasswordAlert" class="hidden bg-rose-50 border border-rose-300 text-rose-700 text-xs font-semibold rounded px-3 py-2"></div>
      <div id="changePasswordSuccess" class="hidden bg-emerald-50 border border-emerald-300 text-emerald-700 text-xs font-semibold rounded px-3 py-2"></div>

      <div>
        <label class="block font-bold text-slate-700 mb-1 text-xs">Current Password</label>
        <input type="password" name="current_password" required class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 focus:bg-white focus:outline-none focus:border-blue-600">
      </div>
      <div>
        <label class="block font-bold text-slate-700 mb-1 text-xs">New Password</label>
        <input type="password" name="new_password" required minlength="6" placeholder="At least 6 characters" class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 focus:bg-white focus:outline-none focus:border-blue-600">
      </div>
      <div>
        <label class="block font-bold text-slate-700 mb-1 text-xs">Confirm New Password</label>
        <input type="password" name="confirm_password" required minlength="6" class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-slate-50 focus:bg-white focus:outline-none focus:border-blue-600">
      </div>

      <div class="flex items-center justify-end space-x-2 pt-3 border-t border-slate-200">
        <button type="button" onclick="closeChangePasswordModal()" class="px-4 py-2 bg-slate-200 hover:bg-slate-300 text-slate-700 font-bold rounded text-xs transition">Cancel</button>
        <button type="submit" id="btnChangePassword" class="px-5 py-2 bg-[#0f3460] hover:bg-[#16213e] text-amber-300 font-bold rounded text-xs transition shadow">Update Password</button>
      </div>
    </form>
  </div>
</div>

<script>
  function openChangePasswordModal() {
    const form = document.getElementById('changePasswordForm');
    form.reset();
    hideChangePasswordAlert();
    hideChangePasswordSuccess();
    document.getElementById('changePasswordModal').classList.remove('hidden');
    document.getElementById('sidebar')?.classList.add('-translate-x-full');
    document.getElementById('sidebarOverlay')?.classList.add('hidden');
  }

  function closeChangePasswordModal() {
    document.getElementById('changePasswordModal').classList.add('hidden');
  }

  function showChangePasswordAlert(msg) {
    const box = document.getElementById('changePasswordAlert');
    box.textContent = msg;
    box.classList.remove('hidden');
  }

  function hideChangePasswordAlert() {
    document.getElementById('changePasswordAlert').classList.add('hidden');
  }

  function showChangePasswordSuccess(msg) {
    const box = document.getElementById('changePasswordSuccess');
    box.textContent = msg;
    box.classList.remove('hidden');
  }

  function hideChangePasswordSuccess() {
    document.getElementById('changePasswordSuccess').classList.add('hidden');
  }

  async function handleChangePasswordSubmit(event) {
    event.preventDefault();
    hideChangePasswordAlert();
    hideChangePasswordSuccess();

    const form = event.target;
    const newPassword = form.new_password.value;
    const confirmPassword = form.confirm_password.value;

    if (newPassword !== confirmPassword) {
      showChangePasswordAlert('New password and confirm password do not match.');
      return false;
    }

    const btn = document.getElementById('btnChangePassword');
    const originalLabel = btn.textContent;
    btn.disabled = true;
    btn.textContent = 'Saving...';

    const payload = {
      current_password: form.current_password.value,
      new_password: newPassword
    };

    try {
      const response = await fetch('/admin/change-password', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify(payload)
      });
      const data = await response.json();

      if (response.ok && data.success) {
        showChangePasswordSuccess(data.message || 'Password updated successfully.');
        form.reset();
      } else {
        showChangePasswordAlert(data.message || 'Failed to update password.');
      }
    } catch (err) {
      showChangePasswordAlert('Network error. Please try again.');
    }

    btn.disabled = false;
    btn.textContent = originalLabel;
    return false;
  }
</script>